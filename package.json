{
  "name": "govskill-chain",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "deploy:sepolia": "npm run deploy:sepolia --workspace=packages/contracts",
    "backend:dev": "npm run dev --workspace=packages/backend",
    "frontend:dev": "npm run dev --workspace=packages/frontend",
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}